# =====================================================================
#  Configuration — Portail Meubles Trois Mousquetaires
#  Copiez ce fichier en « .env » et remplissez vos vraies valeurs.
#  Le fichier .env ne doit JAMAIS être partagé ni versionné (git).
# =====================================================================

# --- Serveur ---------------------------------------------------------
PORT=3000
# Secret utilisé pour signer les sessions. Mettez une longue chaîne aléatoire.
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Code d'accès de la console d'administration (interne).
ADMIN_CODE=1055

# --- Base de données -------------------------------------------------
# Laissez vide pour utiliser data/m3m.sqlite (par défaut).
# DB_PATH=/chemin/absolu/vers/m3m.sqlite

# --- Stripe (paiements + financement maison) -------------------------
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys
# Tant qu'elles sont vides, les paiements passent en « mode simulation »
# (l'app reste 100% utilisable, mais aucune transaction réelle).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications SMS (texto) --------------------------------------
# Exemple avec Twilio. Vide = les demandes sont enregistrées en base
# et affichées dans les logs, mais aucun SMS n'est envoyé.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Numéro qui reçoit les demandes de prix / financement (le magasin) :
NOTIFY_SMS_TO=+15146091239

# --- Notifications courriel -----------------------------------------
# SMTP. Vide = aucun courriel envoyé (demandes tout de même en base).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=info@meublestroismousquetaires.ca

# --- URL publique de l'application ----------------------------------
# Utilisée pour les liens de retour Stripe (connexion bancaire).
# Ex. https://app.meublestroismousquetaires.ca
APP_URL=

# --- Perfex CRM (source de vérité : clients, factures, abonnements) --
# Vide = mode simulation (données de démo). Générez un jeton dans Perfex :
# Setup → API → API Tokens.
PERFEX_URL=
PERFEX_TOKEN=

# --- Agent IA du chat -----------------------------------------------
# Une seule clé suffit. Vide = chat en mode « base de connaissances »
# (répond aux questions fréquentes + escalade vers l'équipe).
# Claude (Anthropic) — recommandé :
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# …ou OpenAI :
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
